{
  "name": "mosaic",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude",
    "cms:dev": "pnpm --filter @mosaic/cms start:dev",
    "cms:prod": "pnpm --filter @mosaic/cms start:prod",
    "seed": "pnpm --filter @mosaic/cms seed",
    "seed:purge": "pnpm --filter @mosaic/cms seed:purge",
    "content:export": "pnpm --filter @mosaic/cms content:export",
    "preview": "pnpm --filter @mosaic/cms preview:export && pnpm --filter @mosaic/site dev"
  },
  "devDependencies": {
    "@mosaic/config": "workspace:*",
    "prettier": "catalog:",
    "turbo": "catalog:"
  }
}
