{
  "name": "mosaic",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cms:dev": "pnpm --filter @mosaic/cms start:dev",
    "cms:prod": "pnpm --filter @mosaic/cms start:prod"
  },
  "devDependencies": {
    "@mosaic/config": "workspace:*",
    "prettier": "catalog:",
    "turbo": "catalog:"
  }
}
