{
  "name": "@mosaic/cms",
  "private": true,
  "type": "module",
  "scripts": {
    "start:dev": "node scripts/with-env.ts dev next dev --port 3000",
    "start:prod": "node scripts/with-env.ts production next dev --port 3001",
    "payload:dev": "node scripts/with-env.ts dev payload",
    "payload:prod": "node scripts/with-env.ts production payload",
    "seed": "node scripts/with-env.ts dev payload run scripts/seed.ts",
    "seed:purge": "node scripts/with-env.ts dev payload run scripts/purge.ts",
    "content:export": "payload run scripts/export.ts",
    "content:export:dev": "node scripts/with-env.ts dev payload run scripts/export.ts",
    "content:export:prod": "node scripts/with-env.ts production payload run scripts/export.ts",
    "preview:export": "node scripts/with-env.ts dev payload run scripts/export.ts drafts",
    "lint": "eslint .",
    "typecheck": "tsc",
    "test": "vitest run",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap"
  },
  "dependencies": {
    "@mosaic/content": "workspace:*",
    "@mosaic/seed": "workspace:*",
    "@payloadcms/next": "catalog:",
    "@payloadcms/richtext-lexical": "catalog:",
    "@payloadcms/ui": "catalog:",
    "graphql": "catalog:",
    "next": "catalog:",
    "payload": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@mosaic/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
