# Copy to .env.dev and fill in. Loaded by `pnpm cms:dev`.
APP_ENV=dev

# Neon project `portfolio`, branch `dev` (seeded). Until Neon is set up, the
# docker-compose Postgres works: postgres://mosaic:mosaic@localhost:5432/mosaic_dev
DATABASE_URL=
PAYLOAD_SECRET=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=portfolio-media-dev
