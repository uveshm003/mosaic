# Copy to .env.prod and fill in. Loaded by `pnpm cms:prod`.
APP_ENV=production

# Neon project `portfolio`, branch `main` (real content only)
DATABASE_URL=
PAYLOAD_SECRET=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=portfolio-media

# Publish button: fine-grained token, repository uveshm003/mosaic only,
# permission "Actions: Read and write". Leave empty to hide the button.
GITHUB_DISPATCH_TOKEN=
GITHUB_REPO=uveshm003/mosaic
