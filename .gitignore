# Dependencies
node_modules/

# Build output
.next/
out/
dist/
build/
.turbo/
.wrangler/
.vercel/

# Payload uploads stored locally until R2 is set up
apps/cms/media/

# Generated content snapshot (built in CI, never committed)
packages/content/snapshot/

# Flutter
demos/flutter/**/.dart_tool/
demos/flutter/**/build/

# Env files (templates are committed)
.env
.env.*
!.env.example
!.env.*.example

# Test output
coverage/
playwright-report/
test-results/
.lighthouseci/

# OS and editors
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.log

# Wrangler local secrets
.dev.vars

# Next.js generated files
next-env.d.ts
*.tsbuildinfo
.neon

# Flutter demo builds (pnpm demos:build)
apps/site/public/flutter/demos/

# Resume export output (pnpm resume:export)
exports/

# End-to-end build (pnpm --filter @mosaic/e2e assemble) and reports
e2e/.dist/
e2e/test-results/
e2e/playwright-report/
